    "vc-demo": "node scripts/issue-vc.js",
    "ipfs-demo": "node scripts/ipfs-store.js",
    "bench:cost": "node scripts/benchmark-cost.js",
    "bench:performance": "node scripts/benchmark-performance.js",
    "bench:offchain": "node scripts/benchmark-offchain.js",
    "recovery-demo": "node scripts/demo-guardian-recovery.js"
  },
  "devDependencies": {
