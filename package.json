  },
  "dependencies": {
    "did-jwt": "8.0.18",
    "did-jwt-vc": "4.0.16",
    "did-resolver": "5.0.1",
    "ethr-did": "3.0.38",
    "ethr-did-resolver": "14.1.0",
    "helia": "7.1.2",
    "@helia/unixfs": "8.0.5",
    "multiformats": "14.0.5",
    "uint8arrays": "6.1.1"
  }
